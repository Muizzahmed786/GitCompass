# ==========================================
# GitCompass — Comprehensive .gitignore
# ==========================================

# ── Python / Virtual Environments ──────────
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ── Node.js / React ────────────────────────
node_modules/
client/node_modules/
client/dist/
client/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment Variables & Secrets ────────
.env
.env.*
!.env.example
server/.env
client/.env

# ── IDEs & Operating System Files ──────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Transient Mining Data / Storage ────────
/tmp/
temp/
*.tmp

# ── Local Databases & Supabase ──────────
.supabase/
*.sqlite
*.sqlite3
*.db

# ── Docker ─────────────────────────────────
docker-compose.override.yml
