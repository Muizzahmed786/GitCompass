# ==========================================
# GitCompass — Comprehensive .gitignore
# ==========================================

# ── Python / Virtual Environments ──────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Node.js / React ────────────────────────
node_modules/
client/node_modules/
client/dist/
client/dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment Variables & Secrets ────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# ── IDEs & Operating System Files ──────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Transient Mining Data / Storage ────────
/tmp/
temp/
*.tmp
