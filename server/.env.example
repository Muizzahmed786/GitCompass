# Supabase credentials — find these in your Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Gemini Primary Provider (Required) ──
GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_FLASH_MODEL=gemini-3.5-flash
# GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite

# ── Groq Secondary Provider (Optional) ──
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
